# ===== Site =====
NEXT_PUBLIC_SITE_URL=https://landingpage-easy2book.vercel.app

# ===== Meta (Facebook / Instagram) =====
NEXT_PUBLIC_META_PIXEL_ID=1674012850599992
META_PIXEL_ID=1674012850599992
# Gestionnaire d'événements > Paramètres > API Conversions > Générer un jeton d'accès
META_ACCESS_TOKEN=
# Optionnel : code de test (onglet "Tester les événements"), à retirer en production
META_TEST_EVENT_CODE=

# ===== TikTok =====
# TikTok Ads Manager > Outils > Événements > Web > votre pixel
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
TIKTOK_PIXEL_ID=
# Paramètres du pixel > Events API > Générer un jeton d'accès
TIKTOK_ACCESS_TOKEN=
TIKTOK_TEST_EVENT_CODE=

# ===== Supabase (stockage des leads) =====
SUPABASE_URL=https://xxxx.supabase.co
# Project Settings > API > service_role (SECRET : jamais dans une variable NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# ===== CRM Easy2Book =====
# Webhook appelé à chaque nouveau lead / changement de statut (Make, Zapier, n8n, API du CRM…)
CRM_WEBHOOK_URL=
# Optionnel : signature HMAC-SHA256 du corps dans l'en-tête X-E2B-Signature
CRM_WEBHOOK_SECRET=
# Clé pour GET /api/leads (export) et POST /api/leads/status (validation des réservations)
CRM_API_KEY=
