# =====================================================================
# Landing pages Easy2Book — variables d'environnement
# Copier en .env.local (local) ou saisir dans Vercel > Settings > Environment Variables.
# Chaque intégration est inactive tant que ses variables sont vides : le site
# reste fonctionnel (le prospect est orienté vers WhatsApp).
# Variables NEXT_PUBLIC_* : visibles dans le navigateur (jamais de secret).
# Autres variables : serveur uniquement.
# =====================================================================

# ----- Site -----
# URL publique du site (balises Open Graph + contrôle d'origine des API)
NEXT_PUBLIC_SITE_URL=https://landingpage-easy2book.vercel.app
# Autres domaines autorisés à appeler /api/leads et /api/track (séparés par des virgules)
ALLOWED_ORIGINS=

# ----- Meta (Facebook / Instagram) -----
# Réglables aussi depuis /admin/integrations (prioritaire ; champ vide = variable ci-dessous).
# Pixel navigateur (public). Valeur par défaut dans le code : 1674012850599992
NEXT_PUBLIC_META_PIXEL_ID=1674012850599992
# Pixel utilisé par l'API Conversions (serveur) ; reprend NEXT_PUBLIC_META_PIXEL_ID si vide
META_PIXEL_ID=1674012850599992
# SECRET — Gestionnaire d'événements > Paramètres > API Conversions > Générer un jeton
META_ACCESS_TOKEN=
# Optionnel — code de l'onglet « Tester les événements » ; à laisser vide en production
META_TEST_EVENT_CODE=

# ----- TikTok -----
# Réglables aussi depuis /admin/integrations (prioritaire ; champ vide = variable ci-dessous).
# Pixel navigateur (public) — TikTok Ads Manager > Outils > Événements > Web
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
# Pixel utilisé par l'Events API (serveur) ; reprend NEXT_PUBLIC_TIKTOK_PIXEL_ID si vide
TIKTOK_PIXEL_ID=
# SECRET — Paramètres du pixel > Events API > Générer un jeton d'accès
TIKTOK_ACCESS_TOKEN=
# Optionnel — code de test ; à laisser vide en production
TIKTOK_TEST_EVENT_CODE=

# ----- Base Supabase DÉDIÉE aux landing pages -----
# Projet Supabase SÉPARÉ, créé pour les landing pages. JAMAIS EasyV4 / EasyV4-preview (CRM) :
# le code refuse ces projets et la migration s'arrête si elle détecte une base EasyV4.
# Projet des landing pages : tdexdlukqciolslvjmhd (eu-west-3)
LANDING_SUPABASE_URL=https://tdexdlukqciolslvjmhd.supabase.co
# SECRET — Project Settings > API > service_role (jamais dans une variable NEXT_PUBLIC_)
LANDING_SUPABASE_SERVICE_ROLE_KEY=

# Facultatif — clé de chiffrement des jetons saisis dans /admin/integrations (32 caractères minimum,
# ex. openssl rand -hex 32). Vide : dérivée de LANDING_SUPABASE_SERVICE_ROLE_KEY.
LANDING_SECRETS_KEY=

# Clé PUBLIQUE (sb_publishable_…) : connexion de l'équipe à /admin via Supabase Auth. Non secrète.
LANDING_SUPABASE_PUBLISHABLE_KEY=

# ----- Notifications de l'équipe à chaque nouveau lead (facultatif) -----
# E-mail via Resend (https://resend.com) — SECRET
RESEND_API_KEY=
# Destinataires, séparés par des virgules
NOTIFY_EMAIL_TO=
# Expéditeur vérifié dans Resend (par défaut : onboarding@resend.dev, pour les essais)
NOTIFY_EMAIL_FROM=
# Webhook (Make, n8n, Zapier, WhatsApp Business…) et secret de signature HMAC (en-tête X-E2B-Signature)
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_SECRET=

# ----- Captcha Cloudflare Turnstile sur les formulaires (facultatif, recommandé) -----
# Cloudflare > Turnstile > Add site. Clé du widget (publique) et clé secrète (serveur).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ----- Administration par script (export, statut) — DÉCONSEILLÉ : l'équipe utilise /admin -----
# Clé non nominative (historique « API ») et export non limité au rôle admin : à ne définir que pour un besoin précis.
# SECRET — 32 caractères minimum, ex. : openssl rand -hex 32
# Envoyé dans l'en-tête x-api-key (jamais dans l'URL). Vide = endpoints désactivés.
LANDING_ADMIN_API_KEY=
